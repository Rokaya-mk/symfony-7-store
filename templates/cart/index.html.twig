{% extends 'base.html.twig' %}


{% block body %}
    <div class="container my-5">
       <h1> Mon Panier </h1>
    <div class="row">
        <div class="col-md-8">
            {% for product in cart %}
                <div class="row mt-2">
                    <div class="col-md-2">
                        <img src="/uploads/{{ product.product.image }}" alt="{{ product.product.name }}" class="img-fluid">
                    </div>
                    <div class="col-md-6">
                        <strong> {{ product.product.name }} </strong>
                        <span class="d-block small">Prix unitaire : {{ product.product.priceWithTva|prix }} </span>
                    </div>
                    <div class="col-md-2 text-right">
                    <a href="{{ path('app_cart_decrease',{id : product.product.id}) }}" >-</a>
                        <span class="badge text-bg-primary">x {{ product.qty }}</span>
                        <a href="{{ path('app_cart_add',{id : product.product.id}) }}" >+</a>
                        
                    </div>
                    <div class="col-md-2">
                        <strong> {{ (product.qty * product.product.priceWithTva) |prix }} </strong>
                    </div>
                </div>
            {% endfor %}

            <a class="d-block mt-3" href="{{ path('app_cart_remove') }}" >Vider le panier</a>

        </div>
        <div class="col-md-4">
            <div class="bg-light p-3">
                <div class="d-flex justify-content-between">
                    <div class="fw-bold">Total Produit</div>
                    <span> {{ totalQuantity }} </span>
                </div>
                <div class="d-flex justify-content-between mt-3">
                    <div class="fw-bold">Prix Total T.T.C</div>
                    <span> {{ totalWt }} </span>
                </div>
                <div>
                    <a href="" class="btn btn-success w-100 mt-3">Commender</a>
                </div>
            </div>
        </div>
    </div>
        
    </div>
{% endblock %}
