{% extends 'base.html.twig' %}


{% block body %}
    <div class="container my-5">
        <h1>Espace Membre</h1>
        <div class="row">
            <div class="col-md-3">
            {% include 'account/_menu.html.twig' %}
            </div>
            <div class="col-md-9">
                <div class="d-flex justify-content-between">
                    <h5>Mes Adresses</h5>
                    <a href="{{ path('app_account_adress_form') }}" class="btn btn-primary mb-3">
                        Ajouter une Adresse
                    </a>
                </div>
                {% if app.user.addresses | length == 0 %}
                    <p class="text-muted">Vous n'avez pas encore d'adresse enregistrée.</p>
                {% else %}
                <div class="row">
                    {% for address in app.user.addresses %}
                    <div class="col-md-4 mt-2">
                        <div class="bg-light p-2 text-center">
                            <p><strong>{{ address.firstname }} {{ address.lastname }}</strong></p>
                            <p>{{ address.address }}</p>
                            <p>{{ address.codePostal }} {{ address.city }}</p>
                            <p>{{ address.country }}</p>
                            <a href="{{ path('app_account_adress_form', {id: address.id}) }}" class="small text-secondary">Modifier</a>
                            <a href="{{ path('app_account_adress_delete', {id: address.id}) }}" class="small text-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette adresse ?')">Supprimer</a>
                        </div>
                    </div>
                        {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
        

    </div>
{% endblock %}
