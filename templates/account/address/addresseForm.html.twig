{% extends 'base.html.twig' %}


{% block body %}
    <div class="container my-5">
        <h1>Espace Membre</h1>
        <div class="row">
            <div class="col-md-3">
            {% include 'account/_menu.html.twig' %}
            </div>
            <div class="col-md-9">
                <h5>Ajouter une Adresse</h5>
                    {{ form_start(addresseForm) }}
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(addresseForm.firstname) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(addresseForm.lastname) }}
                        </div>
                         <div class="col-md-6">
                            {{ form_row(addresseForm.address) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(addresseForm.codePostal) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(addresseForm.city) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(addresseForm.country) }}
                        </div>
                         <div class="col-md-6">
                            {{ form_row(addresseForm.phone) }}
                        </div>
                    </div>
                   

                    {{ form_end(addresseForm) }}
            </div>
        </div>
        

    </div>
{% endblock %}
